# Copia este archivo como .env.local y rellena los valores de tu proyecto de Supabase.
# Ambos valores son públicos por diseño (viajan dentro de la app); la protección real es RLS.
# NUNCA pongas aquí la "secret key" ni la "service_role key".
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
